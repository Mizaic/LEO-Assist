## VT YAML Schema (minimum required fields)

```yaml
- id: "VT-LEO-AI-<NNN>"
  version: "1.0"
  status: "draft"   # draft -> passed after execution

  traceability:
    design_inputs: ["DI-LEO-AI-<NNN>"]
    risks: []   # R-LEO-AI-* IDs

  metadata:
    title: "<Short description>"
    description: >
      <What is being verified and why it matters clinically or safety-wise>
    test_level: "unit"           # unit | integration | system | inspection
    test_type: "functional"
    safety_class: "B"
    automation_status: "automated"
    automation_framework: "pytest"   # or "jest"
    test_file_paths:
      - "<relative/path/to/test_file.py>"

  test_environment:
    environment_type: "development"
    prerequisites: []
    test_data:
      data_type: "synthetic"
      cleanup_required: false

  test_cases:
    - case_id: "VT-<NNN>-TC-001"
      case_name: "<Behaviour under test>"
      priority: "critical"
      test_steps:
        - step_number: 1
          action: "<What to do>"
          expected_result: "<What must happen>"
          verification_method: "automated"
      acceptance_criteria:
        - "<Precise measurable criterion>"

  pass_fail_criteria:
    pass_threshold: "100% critical, 100% all"
    blocking_on_failure: true

  evidence:
    evidence_types: ["automated_test_run"]
    storage_location: "/evidence-bundles/LEO-AI/verification/VT-LEO-AI-<NNN>/"
    retention_period: "7 years"
    immutability: true

  execution_history: []   # fill after first run
```

