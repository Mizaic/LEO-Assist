{
  "_comment": "Rule definitions for the rule-based encounter textcat component. Edit this file to extend or adjust classification patterns. No code changes or model retraining are required.",
  "_priority": "clinical_override > document_transfer > admin_only > clinical (default)",

  "admin_only": {
    "_comment": "Encounters with NO clinical content: admin, system, booking, messaging entries.",
    "phrases": [
      "reminder for appointment",
      "appointment reminder",
      "booking confirmation",
      "appointment cancelled",
      "appointment cancellation",
      "appointment rescheduled",
      "SMS sent",
      "SMS received",
      "text message sent",
      "text message received",
      "implied consent for summary care record",
      "summary care record access",
      "SCR access",
      "SCR migration",
      "event has been made private by another organisation",
      "made private by",
      "online visibility",
      "online services",
      "patient online",
      "data sharing",
      "record sharing",
      "consent notification",
      "sharing notification",
      "registration event",
      "registered with practice",
      "deducted from list",
      "added to list",
      "patient registered",
      "patient deducted",
      "list management",
      "access role",
      "nurse access role",
      "admin access",
      "administrative correction",
      "back-dated entry",
      "system generated",
      "did not attend",
      "DNA appointment",
      "failed to attend",
      "no show"
    ],
    "regex": [
      "(?i)^\\s*sms\\b",
      "(?i)^\\s*text message\\b",
      "(?i)\\breminder\\b.{0,60}\\bappointment\\b",
      "(?i)\\bappointment\\b.{0,60}\\breminder\\b",
      "(?i)\\b(registered|deducted)\\b.{0,40}\\b(patient|list|practice)\\b",
      "(?i)^\\s*(?:dna|did not attend)\\s*[:\\-]?\\s*$",
      "(?i)\\bscr\\b.{0,40}\\b(migration|access|update|consent)\\b",
      "(?i)^\\s*implied consent\\b"
    ],
    "max_length": 60
  },

  "document_transfer": {
    "_comment": "Encounters that are a filing action only — a document was received or sent. The GP encounter itself contains no clinical assessment. The filed document may contain clinical information.",
    "phrases": [
      "discharge summary",
      "discharge letter",
      "clinic letter",
      "clinic letter received",
      "clinic letter filed",
      "referral letter",
      "referral letter sent",
      "outgoing referral",
      "letter received",
      "letter filed",
      "letter from",
      "document filed",
      "document received",
      "correspondence filed",
      "correspondence received",
      "report received",
      "report filed",
      "pathology report",
      "radiology report",
      "radiology letter",
      "imaging report",
      "X-ray report",
      "lab report",
      "laboratory report",
      "blood results received",
      "investigation result received",
      "investigation results filed",
      "GP letter",
      "hospital letter",
      "specialist letter",
      "consultant letter",
      "outpatient letter",
      "secondary care letter",
      "NHS 111 letter",
      "111 report",
      "ambulance report",
      "A&E letter",
      "emergency department letter",
      "mental health letter",
      "community letter",
      "physiotherapy letter",
      "occupational therapy letter",
      "social services letter",
      "safeguarding letter",
      "eRS referral",
      "e-referral sent",
      "e-referral received",
      "PRISM referral received",
      "two week wait referral sent",
      "2WW referral sent"
    ],
    "regex": [
      "(?i)\\b(filed|received)\\b.{0,60}\\b(letter|report|summary|document|correspondence|results?)\\b",
      "(?i)\\b(discharge|clinic|referral|hospital|specialist|consultant|outpatient)\\s+(letter|summary)\\b",
      "(?i)\\b(pathology|radiology|imaging|laboratory|lab|X-ray|MRI|CT|echo)\\s+(report|results?|letter)\\b",
      "(?i)\\bletter\\b.{0,40}\\b(filed|received|from|sent)\\b",
      "(?i)^\\s*(discharge summary|clinic letter|referral letter|report|correspondence)\\b"
    ]
  },

  "clinical_override": {
    "_comment": "Strong signals that a clinician has performed an active clinical assessment. These patterns win over document_transfer and admin_only, ensuring GP-annotated encounters are not misclassified. Use patterns that cannot appear in a filed document without GP authorship.",
    "phrases": [
      "seen in fast track",
      "seen in 2ww clinic",
      "seen in two week wait clinic",
      "fast track referral for suspected",
      "fast track cancer referral",
      "two week wait referral for suspected",
      "presenting complaint",
      "history of presenting complaint",
      "PC:",
      "HPC:",
      "examination reveals",
      "examination shows",
      "examination findings",
      "on examination",
      "examination normal",
      "examination unremarkable",
      "medication review",
      "medication prescribed",
      "prescription issued",
      "new prescription",
      "acute prescription",
      "assessment and plan",
      "impression and plan",
      "clinical impression",
      "clinical assessment"
    ],
    "regex": [
      "(?i)\\bseen\\s+in\\s+fast\\s+track\\b",
      "(?i)\\bseen\\s+in\\s+2ww\\s+clinic\\b",
      "(?i)\\bfast\\s+track\\s+referral\\s+for\\s+suspected\\b",
      "(?i)\\bfast\\s+track\\s+cancer\\s+referral\\b",
      "(?i)\\b2ww\\s+referral\\s+for\\s+suspected\\b",
      "(?i)\\bO/E\\b",
      "(?i)\\bO\\.E\\b",
      "(?i)^\\s*Hx:",
      "(?i)^\\s*O/E:",
      "(?i)^\\s*Dx:",
      "(?i)^\\s*Rx:",
      "(?i)^\\s*Imp:",
      "(?i)^\\s*Plan:",
      "(?i)\\bBP\\s+\\d{2,3}[/\\\\]\\d{2,3}\\b",
      "(?i)\\bblood pressure\\s+\\d{2,3}[/\\\\]\\d{2,3}\\b",
      "(?i)\\bsystolic\\s+\\d{2,3}\\b",
      "(?i)\\b(prescribed|prescribing)\\s+[A-Za-z]{3,}",
      "(?i)\\b\\d+\\s*mg\\s+(od|bd|tds|qds|prn|daily|twice|once)\\b"
    ]
  }
}
