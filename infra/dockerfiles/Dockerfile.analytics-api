# -- Build stage: install deps into /venv ----------------------------------
FROM debian:12-slim AS build
RUN apt-get update && apt-get install --no-install-suggests --no-install-recommends --yes \
    python3-venv gcc libpython3-dev && \
    rm -rf /var/lib/apt/lists/*
RUN python3 -m venv /venv && /venv/bin/pip install --upgrade pip setuptools wheel

FROM build AS build-venv
COPY services/analytics_api/requirements.txt /requirements.txt
RUN /venv/bin/pip install --disable-pip-version-check --no-cache-dir -r /requirements.txt

# -- Runtime: distroless (no shell, no package manager) --------------------
FROM gcr.io/distroless/python3-debian12:nonroot
COPY --from=build-venv /venv /venv
COPY libs/ /app/libs/
COPY services/analytics_api/ /app/services/analytics_api/
WORKDIR /app
ENV PYTHONPATH=/app:/app/services/analytics_api
EXPOSE 8003
ENTRYPOINT ["/venv/bin/python3", "-m", "uvicorn", "services.analytics_api.app.main:app", \
            "--host", "0.0.0.0", "--port", "8003"]
