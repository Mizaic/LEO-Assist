# Top-level training/ holds local model artefacts and datasets that we
# never commit. Anchored to the repo root so we don't accidentally swallow
# nested source folders like libs/training/ or
# services/ui/src/app/api/training/.
/training/
data/cancer_cohort

# Training run checkpoints: large spaCy weights — never commit. README.txt in that
# dir is tracked; everything else is ignored.
/artifacts/model_checkpoints/*
!/artifacts/model_checkpoints/README.txt
artifacts/
data/
# PHI: Neo4j exports of patient identifiers (generated by scripts)
/artifacts/patient_exports/*
!/artifacts/patient_exports/README.txt

