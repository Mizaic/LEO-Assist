# =============================================================================
# Primary Care Audit - Environment Configuration
# Copy to .env and fill in values for your environment.
# =============================================================================

# --- Neo4j Patient Graph (Aura in prod, local Docker in dev) ---
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=patient-dev

# --- Neo4j Knowledge Graph (Aura in prod, local Docker in dev) ---
KNOWLEDGE_GRAPH_NEO4J_URI=bolt://localhost:7688
KNOWLEDGE_GRAPH_NEO4J_USERNAME=neo4j
KNOWLEDGE_GRAPH_NEO4J_PASSWORD=knowledge-dev

# --- Redis (Azure Cache for Redis in prod, local Docker in dev) ---
REDIS_URL=redis://localhost:6379

# --- Azure Service Bus (cloud in prod, in-memory in dev) ---
# Leave blank for local dev (uses in-memory queue adapter).
# MUST be a namespace-level SAS with Send + Listen (e.g. RootManageSharedAccessKey).
# A queue-level or Listen-only SAS will fail when the worker sends to
# referral-assessments-output after completing a durable referral step.
# Format: Endpoint=sb://<ns>.servicebus.windows.net/;SharedAccessKeyName=...;SharedAccessKey=...
AZURE_SERVICE_BUS_CONNECTION_STRING=
AZURE_SERVICE_BUS_NAMESPACE=

# --- Azure AD Authentication (user login -- deployment tenant) ---
AZURE_AD_TENANT_ID=
AZURE_AD_CLIENT_ID=
FHIR_API_SCOPE=
FHIR_API_AUDIENCE=

# --- Microsoft Graph mail (corporate tenant; separate from AZURE_AD_*) ---
# App registration in the tenant that owns the MAIL_FROM_ADDRESS mailbox.
# Grant Mail.Send + Mail.ReadWrite (application) via scripts/entra_mail_graph_perms.sh
MAIL_GRAPH_TENANT_ID=
MAIL_GRAPH_CLIENT_ID=
MAIL_GRAPH_CLIENT_SECRET=
MAIL_FROM_ADDRESS=leo.support@mizaic.com

# --- AWS Bedrock (primary LLM) ---
AWS_BEDROCK_MODEL=arn:aws:bedrock:eu-west-2:204065380870:inference-profile/eu.anthropic.claude-sonnet-4-5-20250929-v1:0
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=eu-west-2
# urllib3 pool size for shared bedrock-runtime clients (default: max(32, SB_MAX_CONCURRENT_CALLS * 4))
# BEDROCK_MAX_POOL_CONNECTIONS=32

# --- Pipeline LLM routing (extraction + disorder gate) ---
PIPELINE_MODEL_PROVIDER=azure
# Bedrock opt-in only. When false (default), aws is never used even if manifests pin aws.
AWS_LLM_ENABLED=false
PIPELINE_MODEL_TIER=small
# Disorder gate / coding verifier judge tier (defaults to PIPELINE_MODEL_TIER / Haiku)
# CONSENSUS_AWS_TIER=small
# Dual-model judge (AWS + Azure small, arbitrator on disagree). Off by default.
PIPELINE_CONSENSUS_MODE=false
# CONSENSUS_DUAL_MODEL=false

# --- Azure OpenAI (primary when PIPELINE_MODEL_PROVIDER=azure) ---
USE_AZURE_PRIMARY=false
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_SMALL_MODEL=gpt-5.4-nano
AZURE_OPENAI_BIG_MODEL=gpt-5.4
AZURE_OPENAI_API_VERSION=2025-04-01-preview

# --- LLM Cache ---
LLM_CACHE_SIZE=10000
LLM_CACHE_TTL_SECONDS=0

# --- LEO widget CDN (Azure Storage Static Website; DI-3C06AFD0) ---
# Local: widget-sdk Vite demo (npm run demo). Deployed: storage web hostname.
# WIDGET_PUBLIC_HOST=localhost:5173
# WIDGET_PUBLIC_HOST=leoaiwidgetcdndev.z33.web.core.windows.net

# --- Service URLs (for inter-service communication) ---
TERMINOLOGY_API_URL=http://localhost:8001
FHIR_API_URL=http://localhost:8002
ANALYTICS_API_URL=http://localhost:8003

# =============================================================================
# Extractor Backend Cutover (extractor_backend_cutover_b936c596)
# =============================================================================

# --- Coding Extractor Backend ---
# "llm"   → always use Bedrock LLM (default; current behaviour)
# "model" → always use spaCy NER service (or in-process)
# "auto"  → prefer model, fallback to llm if unavailable
CODING_EXTRACTOR_BACKEND=llm

# --- Extractor strict mode ---
# "true"  → fail-fast if configured backend is unavailable
# "false" → fallback chain (model → llm) with observable fallback_used event
CODING_EXTRACTOR_STRICT=false

# --- Azure Blob Storage (model artifact store) ---
# Trained NER weights belong here (or MODEL_STORE_CACHE_DIR for offline dev) -
# never commit them under artifacts/model_checkpoints/ in the repo.
# ACA: AZURE_STORAGE_ACCOUNT_URL is set by Bicep; auth is managed identity.
# Local blob access: set account URL and run az login, or leave unset for FS fallback.
AZURE_STORAGE_ACCOUNT_URL=
MODEL_STORE_CONTAINER=ner-models
MODEL_STORE_MODEL_NAME=medspacy_clinical_ner
MODEL_STORE_CACHE_DIR=/tmp/model_cache    # inference service: mount a persistent volume here

# --- Model Inference Service (used when CODING_EXTRACTOR_BACKEND=model|auto) ---
# "service" → call CODING_MODEL_ENDPOINT  (recommended for production)
# "inproc"  → load model file in-process  (dev / resilience)
CODING_MODEL_PROVIDER=service
CODING_MODEL_ENDPOINT=http://localhost:8004
# Required for extraction_method=ner path; keep false unless rollout is validated.
CODING_MODEL_PROVIDER_ENABLED=false
# Model provider runtime URLs (defaults shown)
MODEL_INFERENCE_HEALTH_URL=http://localhost:8004/health
MODEL_INFERENCE_EXTRACT_URL=http://localhost:8004/extract
CODING_MODEL_TIMEOUT_MS=10000
CODING_MODEL_MAX_RETRIES=2
CODING_MODEL_PATH=                    # only used in inproc mode
CODING_MODEL_NAME=medspacy_clinical_ner
CODING_MODEL_VERSION=unknown

# --- Service Bus lock renewal ---
SB_MAX_LOCK_RENEWAL_SECONDS=14400     # 4 hours; covers patients with 300+ encounters

# --- Model Registry ---
# Store backend: "neo4j" = Patient Graph (recommended); "json" = local file
MODEL_REGISTRY_STORE=neo4j
# Path to JSON file when MODEL_REGISTRY_STORE=json (ignored when neo4j)
MODEL_REGISTRY_STORE_PATH=

# Minimum offline eval thresholds for model promotion
MODEL_MIN_PRECISION=0.80
MODEL_MIN_RECALL=0.75
MODEL_CANARY_MIN_PRECISION=0.78
MODEL_CANARY_MIN_RECALL=0.72

# Cross-plan compatibility gate: required training manifest versions
MODEL_REQUIRED_SCHEMA_VERSION=1.0
MODEL_REQUIRED_DEID_VERSION=1.0
MODEL_REQUIRED_LABEL_VERSION=1.0

# --- HITL Operations ---
HITL_LOW_CONFIDENCE_THRESHOLD=0.5    # route coding candidates below this confidence
HITL_PEER_REVIEW_RATE=0.10           # fraction of approved outputs for 10% peer review

# --- Embedding accelerator policy (terminology + few-shot + scripts) ---
# VECTOR_DEVICE: auto|cpu|cuda|mps
# On macOS Apple Silicon (26+), auto prefers mps then CPU fallback.
VECTOR_MODEL=
VECTOR_DIMENSION=768
VECTOR_DEVICE=auto
VECTOR_MPS_FAIL_FAST=true

# --- Training accelerator policy ---
# TRAINING_ACCELERATOR: auto|cpu|cuda|mps
# auto uses mps on supported macOS, otherwise cuda where available.
TRAINING_ACCELERATOR=auto
TRAINING_MPS_FAIL_FAST=true

# --- Inference accelerator policy ---
# MODEL_INFERENCE_ACCELERATOR: auto|cpu|cuda|mps
# Keep MODEL_INFERENCE_MPS_FAIL_FAST=true for strict runtime reliability.
MODEL_INFERENCE_ACCELERATOR=auto
MODEL_INFERENCE_MPS_FAIL_FAST=true

# --- Platform guardrail for MPS ---
# MPS is enabled only on Apple Silicon macOS >= this major version.
MPS_MIN_MACOS_MAJOR=26

# --- NICE Syndication API (guideline ingest) ---
NICE_API_KEY=your-nice-api-key-here

# --- Scenario Validation Widget SDK ---
# Shared secret for server-to-server widget token exchange.
SDK_HOST_SHARED_SECRET=your-secret-here
# Secret for signing widget JWTs.
SDK_WIDGET_TOKEN_SECRET=your-secret-here
SCENARIO_SDK_HOST_SECRET=your-secret-here
SCENARIO_SDK_HOST_ENABLED=1
SCENARIO_SDK_HOST_ID=leo-scenario-runner
SCENARIO_SDK_TENANT_ID=dev-tenant
