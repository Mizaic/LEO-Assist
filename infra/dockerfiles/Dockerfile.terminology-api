FROM python:3.12-slim

WORKDIR /app

COPY libs/ libs/
COPY services/terminology-api/ services/terminology-api/

RUN pip install --no-cache-dir \
    fastapi>=0.115.0 uvicorn>=0.30.0 neo4j>=5.20.0 pydantic>=2.7.0 \
    python-dotenv>=1.0.1 python-jose[cryptography] requests redis

ENV PYTHONPATH=/app
EXPOSE 8001

CMD ["uvicorn", "services.terminology_api.app.main:app", "--host", "0.0.0.0", "--port", "8001", "--reload"]
