# -- Build stage: compile C extensions, install deps into /venv ------------
# libgomp1 required at runtime by spaCy/thinc (OpenMP). Cannot use distroless.
# Python 3.12: medspacy 1.3.1 selects spacy>=3.8 which supports pydantic v2.
FROM python:3.12-slim-bookworm AS build
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential gcc libgomp1 && \
    rm -rf /var/lib/apt/lists/*
RUN python -m venv /venv && /venv/bin/pip install --upgrade pip setuptools wheel

FROM build AS build-venv
COPY services/api/requirements.txt /requirements.txt
RUN /venv/bin/pip install --disable-pip-version-check --no-cache-dir -r /requirements.txt

# -- Runtime: slim with only libgomp, no build tools, non-root user --------
FROM python:3.12-slim-bookworm
RUN apt-get update && apt-get install -y --no-install-recommends libgomp1 && \
    rm -rf /var/lib/apt/lists/* && \
    useradd --no-create-home --shell /sbin/nologin appuser
COPY --from=build-venv /venv /venv
COPY libs/ /app/libs/
COPY services/api/ /app/services/api/
COPY services/coding_worker/ /app/services/coding_worker/
WORKDIR /app
ENV PYTHONPATH=/app:/app/services/api
USER appuser
EXPOSE 8000
ENTRYPOINT ["/venv/bin/uvicorn", "services.api.app.main:app", \
            "--host", "0.0.0.0", "--port", "8000"]
