{
  "name": "@mizaic/leo-widget",
  "version": "0.1.0-mvp.1",
  "private": true,
  "license": "MIT",
  "description": "LEO-by-Mizaic embeddable SBAR widget. Two distribution variants (Shadow-DOM web component and hardened iframe) sharing one source tree.",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./types": "./src/data/types.ts"
  },
  "scripts": {
    "build": "vite build",
    "hash": "node scripts/hash-bundle.mjs",
    "build:iframe": "vite build --config vite.iframe.config.ts",
    "build:demo-cdn": "vite build --config vite.demo-cdn.config.ts",
    "build:all": "npm run build && npm run hash && npm run build:iframe && npm run build:demo-cdn",
    "test": "jest",
    "test:no-coverage": "jest --no-coverage",
    "e2e": "playwright test",
    "e2e:val": "playwright test e2e/val-sbar-widget-2d151cfe.spec.ts --workers=1",
    "e2e:headed": "playwright test --headed",
    "demo": "vite serve --config vite.demo.config.ts"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.1",
    "@playwright/test": "^1.58.2",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@types/jest": "^30.0.0",
    "@types/node": "^20.14.0",
    "jest": "^30.2.0",
    "jest-environment-jsdom": "^30.2.0",
    "ts-jest": "^29.4.6",
    "typescript": "^5.5.0",
    "vite": "^5.4.10"
  }
}
