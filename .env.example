# =============================================================================
# Primary Care Audit - Environment Configuration
# Copy to .env and fill in values for your environment.
# =============================================================================

# --- Neo4j Patient Graph (Aura in prod, local Docker in dev) ---
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=patient-dev

# --- Neo4j Knowledge Graph (Aura in prod, local Docker in dev) ---
KNOWLEDGE_GRAPH_NEO4J_URI=bolt://localhost:7688
KNOWLEDGE_GRAPH_NEO4J_USERNAME=neo4j
KNOWLEDGE_GRAPH_NEO4J_PASSWORD=knowledge-dev

# --- Redis (Azure Cache for Redis in prod, local Docker in dev) ---
REDIS_URL=redis://localhost:6379

# --- Azure Service Bus (cloud in prod, in-memory in dev) ---
# Leave blank for local dev (uses in-memory queue adapter)
AZURE_SERVICE_BUS_CONNECTION_STRING=

# --- Azure AD Authentication ---
AZURE_AD_TENANT_ID=
AZURE_AD_CLIENT_ID=
FHIR_API_SCOPE=
FHIR_API_AUDIENCE=

# --- AWS Bedrock (primary LLM) ---
AWS_BEDROCK_MODEL=arn:aws:bedrock:eu-west-2:204065380870:inference-profile/eu.anthropic.claude-sonnet-4-5-20250929-v1:0
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=eu-west-2

# --- Azure OpenAI (fallback LLM) ---
USE_AZURE_PRIMARY=false
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_BIG_MODEL=gpt-4o
AZURE_OPENAI_API_VERSION=2024-02-15-preview

# --- LLM Cache ---
LLM_CACHE_SIZE=10000
LLM_CACHE_TTL_SECONDS=0

# --- Service URLs (for inter-service communication) ---
TERMINOLOGY_API_URL=http://localhost:8001
FHIR_API_URL=http://localhost:8002
ANALYTICS_API_URL=http://localhost:8003
