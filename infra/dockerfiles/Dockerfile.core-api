# -- Build stage: compile C extensions, install deps into /venv ------------
# libgomp1 required at runtime by spaCy/thinc (OpenMP). Cannot use distroless.
# Python 3.12: medspacy 1.3.1 selects spacy>=3.8 which supports pydantic v2.
# Pin base images: override BASE_IMAGE_BUILD/BASE_IMAGE_RUNTIME with digest in CI.
ARG BASE_IMAGE_BUILD=python:3.12-slim-bookworm
ARG BASE_IMAGE_RUNTIME=python:3.12-slim-bookworm
FROM ${BASE_IMAGE_BUILD} AS build
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential gcc libgomp1 && \
    rm -rf /var/lib/apt/lists/*
RUN python -m venv /venv && /venv/bin/pip install --upgrade pip setuptools wheel

FROM build AS build-venv
COPY services/api/requirements.txt /requirements.txt
RUN /venv/bin/pip install --disable-pip-version-check --no-cache-dir -r /requirements.txt

# -- Runtime: slim with only libgomp, no build tools, non-root user --------
ARG BASE_IMAGE_RUNTIME
FROM ${BASE_IMAGE_RUNTIME}
RUN apt-get update && apt-get install -y --no-install-recommends libgomp1 && \
    rm -rf /var/lib/apt/lists/* && \
    useradd --no-create-home --shell /sbin/nologin appuser
COPY --from=build-venv /venv /venv
COPY libs/ /app/libs/
COPY tests/fixtures/clinical_extraction_scenarios/ /app/tests/fixtures/clinical_extraction_scenarios/
# Labelled set for the teach-time form clash check (libs/pipeline/form_teach_guard.py).
COPY tests/fixtures/form_recognition/ /app/tests/fixtures/form_recognition/
COPY tests/fixtures/form_schema/ /app/tests/fixtures/form_schema/
COPY scripts/ /app/scripts/
COPY services/api/ /app/services/api/
COPY services/coding_worker/ /app/services/coding_worker/
# Shared with terminology API: queries + writeback helpers (routers import these)
COPY services/terminology_api/ /app/services/terminology_api/
WORKDIR /app
ENV PYTHONPATH=/app:/app/services/api \
    UVICORN_WORKERS=4
USER appuser
EXPOSE 8000
ENTRYPOINT ["/venv/bin/uvicorn", "services.api.app.main:app", \
            "--host", "0.0.0.0", "--port", "8000"]
