# -- Build: NLP + Azure async need native/OpenMP libs; align with core-api pattern.
# Distroless was too minimal: no aiohttp transitive guarantee, no libgomp for spaCy.
FROM python:3.12-slim-bookworm AS build
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential gcc libgomp1 && \
    rm -rf /var/lib/apt/lists/*
RUN python -m venv /venv && /venv/bin/pip install --upgrade pip setuptools wheel

FROM build AS build-venv
COPY services/pipeline_worker/requirements.txt /requirements.txt
RUN /venv/bin/pip install --disable-pip-version-check --no-cache-dir -r /requirements.txt
# VECTOR_MODEL is set in ACA; CPU torch keeps image smaller than CUDA.
RUN /venv/bin/pip install --disable-pip-version-check --no-cache-dir \
    torch --index-url https://download.pytorch.org/whl/cpu && \
    /venv/bin/pip install --disable-pip-version-check --no-cache-dir "sentence-transformers>=3.0,<4"

FROM python:3.12-slim-bookworm
RUN apt-get update && apt-get install -y --no-install-recommends libgomp1 && \
    rm -rf /var/lib/apt/lists/* && \
    useradd --no-create-home --shell /sbin/nologin appuser
COPY --from=build-venv /venv /venv
COPY libs/ /app/libs/
COPY services/pipeline_worker/ /app/services/pipeline_worker/
COPY services/analysis_worker/ /app/services/analysis_worker/
WORKDIR /app
ENV PYTHONPATH=/app:/app/services/pipeline_worker
USER appuser
EXPOSE 8006
ENTRYPOINT ["/venv/bin/python3", "-m", "services.pipeline_worker.app.main"]
